{
  "datasets": [
    {
      "name": "vendas_produtos",
      "displayName": "Top 15 Produtos por Receita",
      "queryLines": [
        "-- refresh 2026-09-30 00:31:50 UTC\n",
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  projetovendas.gold.vendas_produtos\n",
        "WHERE\n",
        "  ranking_receita <= 15"
      ]
    },
    {
      "name": "vendas_temporais",
      "displayName": "Vendas Temporais",
      "queryLines": [
        "-- refresh 2026-09-30 00:31:50 UTC\n",
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  projetovendas.gold.vendas_temporais"
      ]
    },
    {
      "name": "kpis_vendas",
      "displayName": "KPIs de Vendas",
      "queryLines": [
        "-- refresh 2026-09-30 00:31:50 UTC\n",
        "SELECT\n",
        "  SUM(receita) AS receita_total,\n",
        "  SUM(total_vendas) AS total_vendas,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN canal_venda = 'ecommerce' THEN total_vendas\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS vendas_ecommerce,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN canal_venda = 'loja_fisica' THEN total_vendas\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS vendas_loja_fisica\n",
        "FROM\n",
        "  projetovendas.gold.vendas_temporais"
      ]
    }
  ],
