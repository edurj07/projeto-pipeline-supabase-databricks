{
  "datasets": [
    {
      "name": "kpis_pricing",
      "displayName": "KPIs de Pricing",
      "queryLines": [
        "-- refresh 2026-09-30 00:31:50 UTC\n",
        "SELECT\n",
        "  COUNT(*) AS total_produtos,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN classificacao_preco = 'MAIS_CARO_QUE_TODOS' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS mais_caros,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN classificacao_preco = 'MAIS_BARATO_QUE_TODOS' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS mais_baratos,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN possui_preco_suspeito = true THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS com_suspeito,\n",
        "  ROUND(AVG(diferenca_pct_vs_media), 2) AS diferenca_media_pct\n",
        "FROM\n",
        "  projetovendas.gold.precos_competitividade"
      ]
    },
    {
      "name": "precos_dados",
      "displayName": "Preços e Competitividade",
      "queryLines": [
        "-- refresh 2026-09-30 00:31:50 UTC\n",
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  projetovendas.gold.precos_competitividade"
      ]
    },
    {
      "name": "suspeitos",
      "displayName": "Produtos com Preço Suspeito",
      "queryLines": [
        "-- refresh 2026-09-30 00:31:50 UTC\n",
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  projetovendas.gold.precos_competitividade\n",
        "WHERE\n",
        "  possui_preco_suspeito = true\n",
        "ORDER BY\n",
        "  diferenca_pct_vs_media DESC"
      ]
    },
    {
      "name": "mais_caros",
      "displayName": "Top 20 Mais Caros que Concorrentes",
      "queryLines": [
        "-- refresh 2026-09-30 00:31:50 UTC\n",
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  projetovendas.gold.precos_competitividade\n",
        "WHERE\n",
        "  classificacao_preco = 'MAIS_CARO_QUE_TODOS'\n",
        "ORDER BY\n",
        "  diferenca_pct_vs_media DESC\n",
        "LIMIT 20"
      ]
    }
  ],
